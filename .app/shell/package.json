{
  "name": "@inkcopy/desktop-shell",
  "version": "0.2.3",
  "private": true,
  "description": "INKCOPY desktop shell — Electron + React renderer",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,magenta \"pnpm dev:vite\" \"pnpm dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5673 && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pretest:e2e": "pnpm build",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "package:win": "pnpm build && electron-builder --win portable zip --publish never",
    "publish:win": "pnpm build && electron-builder --win portable zip --publish always",
    "package:mac": "pnpm build && electron-builder --mac dmg zip --publish never",
    "publish:mac": "pnpm build && electron-builder --mac dmg zip --publish always"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uiohook-napi": "^1.5.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.inkcopy.app",
    "productName": "INKCOPY",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/__tests__/**",
      "package.json",
      "public/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "snibzyz",
        "repo": "inkcopy"
      }
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "../../assets/inkcopy.ico"
    },
    "portable": {
      "artifactName": "INKCOPY-Electron-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "../../assets/inkcopy.png",
      "identity": null,
      "artifactName": "INKCOPY-Electron-${version}-${arch}.${ext}"
    },
    "dmg": {
      "writeUpdateInfo": false
    }
  }
}
